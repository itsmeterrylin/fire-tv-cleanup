<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day photo, swapped in code. -->
    <ImageView
        android:id="@+id/bgPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim" />

    <!-- tvOS-style frosted band behind the apps: a blurred, darkened copy of the photo's lower part, built in code. -->
    <ImageView
        android:id="@+id/bgBand"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. Hidden: it tinted the whole wallpaper (tvOS has none). -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:alpha="0" />

    <!-- Large name of the focused dock app, above the glass shelf at its left edge; positioned in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="34sp"
        android:fontFamily="@font/inter"
        android:fontVariationSettings="'wght' 300"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:shadowColor="#66000000"
        android:shadowRadius="10"
        android:shadowDy="1"
        android:singleLine="true" />

    <!-- Name of the current wallpaper, under the top-right buttons. -->
    <TextView
        android:id="@+id/wallCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="78dp"
        android:layout_marginEnd="60dp"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/inter"
        android:fontVariationSettings="'wght' 500"
        android:shadowColor="#80000000"
        android:shadowRadius="6"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <!-- tvOS-style stack in Inter (a free SF Pro look-alike): greeting, large light clock, date. -->
                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textColor="#F2FFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="-0.01" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="60sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 250"
                        android:letterSpacing="-0.03"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="10dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="18sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 500" />
                </LinearLayout>

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="4dp"
                    android:format12Hour="EEEE, d MMMM"
                    android:format24Hour="EEEE, d MMMM"
                    android:textColor="#B3FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 500" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopIconButton"
                    android:contentDescription="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopIconButton"
                    android:contentDescription="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="220dp"
                android:paddingEnd="220dp"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- Dot under the focused dock icon, positioned in code. -->
    <View
        android:id="@+id/dockDot"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:alpha="0"
        android:background="@drawable/dock_dot" />

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes from all apps (to spot Amazon's home screen and this launcher). Reads screen content only
     on Amazon's home screen: the app tile labels, to click this launcher's tile. Key filtering is on only so
     D-pad keys can be swallowed while the black cover hides Amazon's home. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/home_redirect_description" />

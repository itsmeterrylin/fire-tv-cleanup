<?xml version="1.0" encoding="utf-8"?>
<!-- Only "force lock": lets the Tools menu and sleep timer put the TV to standby (DevicePolicyManager.lockNow).
     Activated over adb: dpm set-active-admin com.gathin.tvhome/.AdminReceiver -->
<device-admin>
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Starting dock, in this order. After that the dock is edited on the TV (hold OK or press Menu on an app)
         and saved on the device. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.nuvio.tv</item>
        <item>org.smarttube.stable</item>
        <item>com.apple.atve.amazon.appletv</item>
        <item>com.sling</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.amazon.tv.livetv</item>
        <item>com.mediatek.opapp</item>      <!-- 16 European satellite-provider shortcuts -->
        <item>com.amazon.smarthomemapviewapp</item>  <!-- Alexa Smart Home -->
        <item>com.amazon.spiderpork</item>   <!-- Luna -->
        <item>com.amazon.bueller.music</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.amazon.tv.livetv</string>

    <!-- Tiles per row in the grid, and the most apps the dock can hold. -->
    <integer name="columns">4</integer>

    <!-- Weather next to the greeting. Leave latitude/longitude empty to use the network's approximate
         location (looked up once, then cached). weather_units: auto, c, or f. -->
    <string name="weather_latitude" translatable="false"></string>
    <string name="weather_longitude" translatable="false"></string>
    <string name="weather_units" translatable="false">auto</string>
</resources>
